rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // BULLETPROOF FIX: Check if authenticated before trying to read the user's UID
    function userRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@jefinvestment.com'
        || request.auth.token.email == 'jefinvestmentmw@gmail.com'
        || userRole() == 'ADMIN'
      );
    }
    
    function isManager() {
      return isAuthenticated() && userRole() == 'MANAGER';
    }

    // Settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow update: if request.auth.uid == userId || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Products (Inventory)
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin() || isManager();
      allow update: if isAdmin() || isManager() ||
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock < resource.data.stock
        );
    }

    // Sales and Credits
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAdmin() || isManager();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Stationery Services
    match /stationeryServices/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }
    
    // Held Carts (POS — per-user subcollection, cross-device sync)
    match /users/{userId}/heldCarts/{cartId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Audit Logs — added delete for admin (fixes Clear Logs on mobile)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Password Change Requests (new password approval flow)
    match /passwordRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isAuthenticated();
    }
    
    // Branches
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
