rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@jefinvestment.com'
        || request.auth.token.email == 'jefinvestmentmw@gmail.com'
        || userRole() == 'ADMIN'
      );
    }
    
    function isManager() {
      return isAuthenticated() && userRole() == 'MANAGER';
    }

    // Settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if request.auth.uid == userId || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Products (Inventory)
    match /products/{productId} {
      allow read: if isAuthenticated();
      // Admins and Managers can make full changes to product data
      allow create, delete: if isAdmin() || isManager();
      allow update: if isAdmin() || isManager() ||
        // Cashiers can ONLY decrement the stock field during a sale
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock < resource.data.stock
        );
    }

    // Sales and Credits
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      // Anyone can create a sale
      allow create: if isAuthenticated();
      // Only admins can update or delete sales (e.g. processing returns)
      allow update, delete: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Stationery Services
    match /stationeryServices/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }
    
    // Held Carts (POS — per-user subcollection, cross-device sync)
    match /users/{userId}/heldCarts/{cartId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Audit Logs — frontend restricts reads to admins; any authenticated user can write
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Password Reset Requests
    match /passwordResetRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      // Anyone can create a request (they are logged out when they forgot their password)
      allow create: if request.resource.data.keys().hasAll(['email', 'status', 'timestamp'])
                    && request.resource.data.status == 'pending';
    }
    
    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
