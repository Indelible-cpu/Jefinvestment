rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
        || request.auth.token.email == 'admin@jefinvestment.com'
        || request.auth.token.email == 'jefinvestmentmw@gmail.com'
      );
    }
    
    function isManager() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MANAGER';
    }

    // Settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if request.auth.uid == userId || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Products (Inventory)
    match /products/{productId} {
      allow read: if isAuthenticated();
      // Only admins/managers should typically manage inventory, but if cashiers need to add items, change this.
      allow write: if isAdmin() || isManager();
    }

    // Sales and Credits
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      // Anyone can create a sale
      allow create: if isAuthenticated();
      // Only admins can update or delete sales (e.g. processing returns)
      allow update, delete: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }
    
    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
