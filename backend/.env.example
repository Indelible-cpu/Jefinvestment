# =============================================================================
# JIMS ERP — Backend Environment Variables EXAMPLE
# Copy this to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================================

# ── Neon PostgreSQL (pooled connection for Cloudflare Workers) ────────────────
# Get this from: Neon dashboard → Connection Details → Pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-at-least-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Cloudflare Pages URL or custom domain
CORS_ORIGIN=https://jefinvestment.pages.dev
